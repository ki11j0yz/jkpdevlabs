---
// src/layouts/BaseLayout.astro
// Frontmatter: declared variables run on the server during build-time
const { title = "{jkpdevlabs} // Retro-Groove Systems Portfolio" } =
    Astro.props;
const brand = "{jkpdevlabs}";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <!-- Tailwind CSS CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest"></script>
        <style>
            /* Gruvbox scrollbar styling */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #1d2021;
            }

            ::-webkit-scrollbar-thumb {
                background: #3c3836;
                border-radius: 3px;
            }

            .font-mono-code {
                font-family:
                    ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
                    "Liberation Mono", "Courier New", monospace;
            }
        </style>
    </head>
    <!-- Gruvbox Dark Hard Background (#1d2021) and Soft Cream Text (#ebdbb2) -->
    <body
        class="bg-[#1d2021] text-[#ebdbb2] min-h-screen flex flex-col justify-between font-sans selection:bg-[#fabd2f] selection:text-[#1d2021]"
    >
        <!-- Navigation Header -->
        <header
            class="border-b border-[#3c3836] bg-[#282828]/95 backdrop-blur sticky top-0 z-50"
        >
            <div
                class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center"
            >
                <div class="flex items-center space-x-4">
                    <!-- Scaled Up Circular Container (48px) with macOS Spring Transition -->
                    <div
                        id="nav-avatar"
                        class="w-12 h-12 rounded-full overflow-hidden border border-[#504945] bg-[#3c3836] shadow-md flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] scale-0 opacity-0 origin-center"
                    >
                        <!-- Smooth, non-stretched scaling -->
                        <img
                            src="/images/avatar.png"
                            alt="jkpdevlabs avatar"
                            class="w-[115%] max-w-none h-auto transform translate-x-[4%]"
                        />
                    </div>
                    <!-- Scaled Up Brand Name (20px) using Frontmatter variable -->
                    <span
                        class="text-[#b8bb26] font-bold font-mono-code text-xl"
                        >{brand}</span
                    >
                </div>
                <nav
                    class="flex items-center space-x-6 text-sm font-medium text-[#a89984]"
                >
                    <a
                        href="#about"
                        class="hover:text-[#fabd2f] transition-colors">About</a
                    >
                    <a
                        href="#homelab"
                        class="hover:text-[#fabd2f] transition-colors"
                        >Homelab</a
                    >
                    <a
                        href="#networking"
                        class="hover:text-[#fabd2f] transition-colors"
                        >Networking</a
                    >
                    <a
                        href="#webdev"
                        class="hover:text-[#fabd2f] transition-colors"
                        >Development</a
                    >
                    <a
                        href="#contact"
                        class="px-3 py-1.5 rounded bg-[#3c3836] text-[#ebdbb2] hover:bg-[#fabd2f] hover:text-[#1d2021] border border-[#504945] transition-all font-mono-code text-xs"
                        >ssh contact@jkp.dev</a
                    >
                </nav>
            </div>
        </header>

        <!-- Slot: Page-specific content gets injected here -->
        <slot />

        <!-- Footer -->
        <footer
            class="border-t border-[#3c3836] bg-[#1d2021] py-8 text-xs font-mono-code text-[#a89984]"
        >
            <div
                class="max-w-5xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4"
            >
                <div class="flex items-center space-x-2">
                    <span>&copy; 2026 {brand}. All configs local-first.</span>
                </div>
                <div class="flex items-center space-x-6">
                    <span>MikroTik RB5009</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#504945]"></span>
                    <span>Proxmox VE 8.1</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#504945]"></span>
                    <span>ZFS Mirror</span>
                </div>
            </div>
        </footer>

        <!-- Initialize Lucide Icons & Bouncy Scroll Transition -->
        <script>
            // TypeScript definition for Lucide CDN global loaded in head
            declare const lucide: any;

            lucide.createIcons();

            // Target the two avatars
            const navAvatar = document.getElementById("nav-avatar");
            const heroAvatar = document.getElementById("hero-avatar");

            // Listen for scroll events
            window.addEventListener("scroll", () => {
                // Trigger transition once the user scrolls down past 80px
                if (window.scrollY > 80) {
                    // Shrink and fade out the large Hero avatar
                    heroAvatar?.classList.add("scale-0", "opacity-0");
                    // Bounce and fade in the small Navbar avatar
                    navAvatar?.classList.remove("scale-0", "opacity-0");
                } else {
                    // Bring back the large Hero avatar
                    heroAvatar?.classList.remove("scale-0", "opacity-0");
                    // Shrink and hide the Navbar avatar
                    navAvatar?.classList.add("scale-0", "opacity-0");
                }
            });
        </script>
    </body>
</html>
