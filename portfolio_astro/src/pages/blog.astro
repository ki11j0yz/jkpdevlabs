---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
// Fetch all posts and sort by date
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Lab Chronicles // jkpdevlabs" showAvatar>
    <main class="max-w-5xl w-full mx-auto px-4 py-20">
        <h1
            class="text-5xl md:text-6xl font-extrabold mb-10 font-mono-code"
            style="-webkit-text-stroke: 1.5px #fabd2f; color: transparent;"
        >
            THE_LAB_CHRONICLES
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                posts.map((post, index) => (
                    <a href={`/blog/${post.id}/`} class="group">
                        <div
                            class:list={[
                                "bg-[#282828] border p-6 rounded-lg transition-all duration-300",
                                index === 0
                                    ? "border-[#fabd2f]/40 shadow-[0_0_30px_rgba(250,189,47,0.25)] hover:shadow-[0_0_45px_rgba(250,189,47,0.45)] hover:border-[#fabd2f]"
                                    : "border-[#3c3836] hover:border-[#504945] hover:shadow-[0_0_25px_rgba(250,189,47,0.15)]",
                            ]}
                        >
                            <p class="text-xs text-[#a89984] mb-2 font-mono-code">
                                {post.data.pubDate.toLocaleDateString()}
                            </p>
                            <h2 class="text-xl font-bold text-[#fbf1c7] group-hover:text-[#fabd2f] transition-colors">
                                {post.data.title}
                            </h2>
                            <p class="text-sm text-[#bdae93] mt-2 line-clamp-2">
                                {post.data.description}
                            </p>
                            <div class="mt-4 flex gap-2 flex-wrap">
                                {post.data.tags.map((tag) => (
                                    <span class="text-[10px] bg-[#3c3836] text-[#b8bb26] px-2 py-1 rounded-full uppercase font-mono-code border border-[#504945]">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</BaseLayout>
